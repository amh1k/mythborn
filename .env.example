# Go API
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Supabase Auth issuer/JWKS and private Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_PHOTO_BUCKET=mythborn-photos

# Exact browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Temporal worker and model settings (used by cmd/worker)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
GEMINI_API_KEY=

# Conservative starting allocation; set to your model/project's actual quotas.
# Every worker uses the same total worker count. Keep one worker initially.
MODEL_RPM=10
MODEL_INPUT_TPM=60000
MODEL_WORKER_COUNT=1
MODEL_EMBEDDING_RPM=15
MODEL_EMBEDDING_INPUT_TPM=100000

# Freeze these switches at round start. Disabling preserves saved gameplay history.
GAMEPLAY_MYSTERIES_ENABLED=true
GAMEPLAY_RELATIONSHIPS_ENABLED=true
GAMEPLAY_CULTURE_ENABLED=true
